<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.dangerous.class.inherit.s6r_l10n_eu_product_adr</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="l10n_eu_product_adr.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="adr_goods_id" position="after">
                <field name="adr_goods_is_nos_entry" invisible="1"/>
                <field name="nos_supplement_ids"
                       widget="many2many_tags" options="{'no_create_edit': True}"
                       required="is_storable and is_dangerous and adr_goods_is_nos_entry"
                       invisible="not adr_goods_is_nos_entry"/>
            </field>
            <field name="adr_classification_code" position="after">
                <field name="is_environmentally_hazardous"/>
            </field>
        </field>
    </record>

</odoo>
