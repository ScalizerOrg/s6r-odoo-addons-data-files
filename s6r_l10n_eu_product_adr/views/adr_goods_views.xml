<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="adr_goods_view_form" model="ir.ui.view">
        <field name="name">adr.goods.view.form.inherit.s6r_l10n_eu_product_adr</field>
        <field name="model">adr.goods</field>
        <field name="inherit_id" ref="l10n_eu_product_adr.adr_goods_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_nos_entry"/>
            </field>
        </field>
    </record>

    <record id="adr_goods_view_search" model="ir.ui.view">
        <field name="name">adr.goods.view.search.inherit.s6r_l10n_eu_product_adr</field>
        <field name="model">adr.goods</field>
        <field name="inherit_id" ref="l10n_eu_product_adr.adr_goods_view_search"/>
        <field name="arch" type="xml">
            <filter name="active" position="after">
                <separator/>
                <filter name="is_nos_entry" string="N.O.S. Entry" domain="[('is_nos_entry', '=', True)]"/>
            </filter>
        </field>
    </record>

</odoo>
